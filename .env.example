# AgentLoom Multimedia Knowledge Ingestion Agent Environment Config

# LLM & ASR Provider Keys
OPENAI_API_KEY=sk-proj-...
# Optional alternative ASR / LLM providers
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# ASR Engine Selection: 'whisper_api' | 'groq' | 'local_whisper'
ASR_ENGINE=whisper_api
WHISPER_MODEL=whisper-1

# LLM Distillation Model: 'gpt-4o' | 'gpt-4o-mini' | 'claude-3-5-sonnet' | 'llama-3.3-70b'
DISTILLATION_MODEL=gpt-4o-mini

# AgentLoom Core Integration
AGENTLOOM_DASHBOARD_URL=http://127.0.0.1:8000
