# AgentLoom Multimedia Knowledge Ingestion Agent Environment Config

# LLM & ASR Provider Keys
OPENAI_API_KEY=sk-proj-...
# Optional alternative ASR / LLM providers
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# --- Transcript acquisition ---------------------------------------------------
# Route: 'auto' (captions, then ASR) | 'fast' (captions only) | 'heavy' (ASR only).
# Captions are free but cue-level: no word or speaker timing. Use 'heavy' when anchors
# must be precise.
TRANSCRIPT_ROUTE=auto

# ASR Engine: 'whisper_api' | 'faster_whisper' | 'whisperx' | 'whisper_cpp'
# whisper_api is the v1 default (zero setup, segment-level timings only). whisperx and
# whisper_cpp are registered but not yet implemented; see plan §2.2.
ASR_ENGINE=whisper_api
ASR_MODEL=whisper-1
# faster_whisper only:
# ASR_MODEL_SIZE=large-v3
# ASR_COMPUTE_TYPE=int8
# ASR_DEVICE=cpu
# ASR_WORD_TIMESTAMPS=1

# Vocabulary bias for mixed zh/en domain speech. Defaults to config/asr-glossary.txt.
# ASR_GLOSSARY=Meta,Andromeda,CBO
# ASR_GLOSSARY_FILE=config/asr-glossary.txt

# Chinese script normalization. Whisper returns Traditional for this content even when the
# source is Simplified, which would put two spellings of every entity in the index and KG.
# Raw text is always preserved in the canonical transcript. Set to 'off' to disable.
TRANSCRIPT_NORMALIZE_SCRIPT=on
TRANSCRIPT_OPENCC_CONFIG=t2s

# LLM Distillation Model: 'gpt-5.6-luna' | 'gpt-5.6-terra' | 'gpt-5.6-sol' | 'gpt-4o-mini'
# Luna is the default: cheapest GPT-5.6 tier, knowledge cutoff 2026-02-16.
DISTILLATION_MODEL=gpt-5.6-luna
# Optional. GPT-5.6 only: none | low | medium | high | xhigh | max
DISTILLATION_REASONING_EFFORT=low

# Stronger tier, used only for document synthesis and skill extraction — the two passes that
# reason across the whole item. Per-segment work stays on DISTILLATION_MODEL.
SYNTHESIS_MODEL=gpt-5.6-terra

# --- Semantic segmentation ----------------------------------------------------
# Segmentation reuses the embedding model below. With embeddings disabled the transcript is
# left as a single span rather than cut on invented boundaries.
#
# Boundary resolution equals the chunk size: a smaller value buys precision with more
# embedding calls. Boundaries can only fall on chunk edges.
# SEGMENT_CHUNK_SECONDS=15
#
# Cut at distances above this percentile of observed chunk-to-chunk distances. Relative
# rather than absolute, because a cosine threshold tuned on English prose does not transfer
# to Chinese speech. Lower = more segments.
# SEGMENT_PERCENTILE=85
#
# Guardrails on segment length, in seconds.
# SEGMENT_MIN_SECONDS=60
# SEGMENT_MAX_SECONDS=300

# --- Candidate skill gate -----------------------------------------------------
# Number of distinct step-marking cues ("第一步", "then", "click"...) required before skill
# extraction runs at all. Commentary should not yield a "skill"; raise this if prose keeps
# being extracted as a procedure, lower it if real tutorials are being skipped.
# SKILL_PROCEDURAL_THRESHOLD=6

# --- Knowledge graph ----------------------------------------------------------
# Segments are extracted in parallel; each is one LLM call. Raise for throughput, lower if
# you hit rate limits (a failed segment is contained, but you lose its edges).
# KG_MAX_WORKERS=4
#
# Cosine similarity above which two surfaces are offered as a *merge candidate*. Nothing is
# ever merged automatically — similarity is not evidence of identity — so this only controls
# how much a reviewer is asked to look at.
# KG_MERGE_THRESHOLD=0.88

# --- Search index -------------------------------------------------------------
# Embedding model for window vectors. The model id is stored per row, because vectors from
# different models are not comparable; switching requires a full re-index.
# 'text-embedding-3-small' (default, cheapest) | 'text-embedding-3-large'
EMBEDDING_MODEL=text-embedding-3-small

# Set to 1 to build and query a keyword-only index. Note the trade-off being made when
# embeddings are on: window text is sent to the embedding API. Fine for public YouTube
# content; revisit before private recordings or paid course material.
# SEARCH_DISABLE_EMBEDDINGS=0

# AgentLoom Core Integration
AGENTLOOM_DASHBOARD_URL=http://127.0.0.1:8000

# --- Verified takeaway (P6) -------------------------------------------------------
# Groundedness escalation. Cheap n-gram tiers settle the clear cases; the ambiguous
# band goes to an LLM entailment judge. Set to 0 to keep costs down and accept
# "needs_review" for the remainder instead.
TAKEAWAY_ESCALATE=1

# Optional local entailment model for the NLI tier, which replaces the LLM judge.
# Must be multilingual for Chinese content — mDeBERTa-v3-base-xnli rather than
# HHEM-2.1-open or MiniCheck, both of which are English-only. Requires transformers
# and torch, which are not installed by default.
# NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

# External retrieval for veracity checking. Without this, checkable claims are
# reported "unverifiable" (not checked) rather than guessed at from model memory.
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
